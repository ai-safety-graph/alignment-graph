FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md seeds.txt seeds_subtopics.tsv ./
COPY src ./src

# Unlike the API's Dockerfile, this image needs the full pipeline: numpy,
# transformers/sentence-transformers (SPECTER2 + BGE embeddings), umap, and
# the OpenAI client for llm-classify. Deliberately not merged into the API
# image -- see Dockerfile's comment -- so the always-on API service stays
# light. Install the CPU-only torch wheel explicitly first so pip doesn't
# pull the much larger default (CUDA) build; this job runs on Railway CPU.
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      torch \
    && pip install --no-cache-dir ".[pipeline,llm]"

# torch/numpy's BLAS backends default to one thread per CPU core reported by
# /proc/cpuinfo, which in a container is often the *host's* full core count,
# not this service's actual cgroup CPU quota -- confirmed in practice on
# Railway (8 vCPU limit, embed spawned enough threads to show ~10 vCPU of
# contention and made no progress for 10+ minutes). Capping thread counts
# below the quota avoids the context-switch thrashing; override via a
# Railway service variable if the plan's CPU limit changes.
ENV OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    NUMEXPR_NUM_THREADS=4

CMD ["aisafety-pipeline", "run-all"]
