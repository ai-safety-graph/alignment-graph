# Copy this file to .env and fill in the values you need.
# .env is loaded automatically from the project root (see config.py).

# --- Database (required) ---------------------------------------------------
# PostgreSQL + pgvector DSN. Required by every pipeline command and the API.
# For the bundled `docker compose up -d` Postgres service, use:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aisafety

# --- Pipeline (optional) ----------------------------------------------------
# Directory for local state (harvest resumption token, etc). Default: ./data
# AIS_DATA_DIR=./data

# Path to the OAI-PMH harvest resumption-token file. Default: <AIS_DATA_DIR>/last_run.txt
# AIS_STATE_FILE=./data/last_run.txt

# User-Agent sent to arXiv's OAI-PMH endpoint. Set this to something that
# identifies you/your deployment per arXiv's API etiquette guidelines.
# AIS_USER_AGENT=aisafety-pipeline/1.0 (+contact: your-email@example.com)

# --- API (optional) ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins for the FastAPI backend.
CORS_ORIGINS=https://alignmentgraph.com,https://alignment-graph.netlify.app,http://localhost:5173,http://localhost:4173

# Enables the /api/search semantic-search endpoint. Loads a transformer
# embedding model into memory at startup — only enable on deployments that
# run the "pipeline" extra alongside the API.
ENABLE_SEMANTIC_SEARCH=false

# Database connection pool for the API. Requests wait up to
# API_DB_POOL_TIMEOUT seconds for a free connection, then get a 503.
API_DB_POOL_MIN=1
API_DB_POOL_MAX=10
API_DB_POOL_TIMEOUT=5

# Per-client-IP rate limits. "Expensive" applies to /api/papers/related,
# /api/graph/subset, /api/graph/range and /api/search; "default" to every
# other route except /health.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPENSIVE=30/minute

# --- LLM classification (optional, only needed for `aisafety-pipeline llm-classify`) -------
# OpenAI API key for the combined relevance + taxonomy LLM stage.
# OPENAI_API_KEY=sk-...

# Model name/id passed to the OpenAI API. Kept as a plain string so it's
# easy to swap.
# LLM_MODEL=gpt-5.6-luna

# LLM_MAX_RETRIES=5
# LLM_REQUEST_TIMEOUT_SEC=60
